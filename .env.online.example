# Copie este arquivo para .env.online e ajuste os valores

# Seguranca
APP_ENV=production
SECRET_KEY=troque_por_uma_chave_grande_e_aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Banco
POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=troque_esta_senha

# Portas publicas da VPS
WEB_PORT=80
API_PORT=8000

# URL publica da API usada no build do frontend
# Exemplo com IP publico:
# VITE_API_URL=http://SEU_IP_PUBLICO:8000
# Exemplo com dominio:
# VITE_API_URL=https://api.seudominio.com
VITE_API_URL=http://SEU_IP_PUBLICO:8000

# CORS da API
# Inclua a URL do frontend em producao
# Exemplo com IP publico:
# FRONTEND_ORIGINS=http://SEU_IP_PUBLICO,http://SEU_IP_PUBLICO:80
# Exemplo com dominio:
# FRONTEND_ORIGINS=https://app.seudominio.com
FRONTEND_ORIGINS=http://SEU_IP_PUBLICO,http://SEU_IP_PUBLICO:80

# Opcional: regex para permitir origem de forma mais ampla
CORS_ALLOW_ORIGIN_REGEX=^https?://([a-zA-Z0-9-]+\.)*[a-zA-Z0-9-]+(:[0-9]{2,5})?$

# Email (opcional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
