# =========================
# AEGIS - Sniffer Host
# =========================

# Endpoint público da API cloud para ingestão dos flows
SNIFFER_FLOW_ENDPOINT=https://api.seu-dominio.com/sniffer/flow-input

# Interfaces do host local monitorizadas pelo container
SNIFFER_INTERFACES=eth0,eth1

# Runtime do cicflow
SNIFFER_EXPIRED_UPDATE=1.0
SNIFFER_PACKETS_PER_GC=50
SNIFFER_VERBOSE=0
ENABLE_HEURISTIC_ATTACK_OVERRIDE=1

# Tuning IDS/IPS
SENSOR_ZONE=lan
IPS_ATTACK_WINDOW_SECONDS=120
IPS_MIN_BLOCK_CONFIDENCE=0.85
ATTACK_MIN_CONFIDENCE=0.82
INFILTRATION_MIN_CONFIDENCE=0.90
LOCAL_NOISE_MIN_CONFIDENCE=0.93

# Overrides opcionais por zona
# IPS_WAN_THRESHOLD=4
# IPS_WAN_MIN_BLOCK_CONFIDENCE=0.82
# IPS_WAN_ATTACK_WINDOW_SECONDS=90
# IPS_LAN_THRESHOLD=5
# IPS_LAN_MIN_BLOCK_CONFIDENCE=0.85
# IPS_LAN_ATTACK_WINDOW_SECONDS=120
# IPS_WLAN_THRESHOLD=5
# IPS_WLAN_MIN_BLOCK_CONFIDENCE=0.85
# IPS_WLAN_ATTACK_WINDOW_SECONDS=120
