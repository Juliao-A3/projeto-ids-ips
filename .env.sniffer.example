# =========================
# AEGIS - Sniffer Host
# =========================

# Endpoint público da API cloud para ingestão dos flows
SNIFFER_FLOW_ENDPOINT=https://projeto-ids-ips.onrender.com/sniffer/flow-input

# URL base da cloud (fallback para o start_sniffer.py)
CLOUD_URL=https://projeto-ids-ips.onrender.com

# Interfaces do host local monitorizadas pelo container
SNIFFER_INTERFACES=eth0,eth1,wlan0

# Runtime do cicflow
SNIFFER_EXPIRED_UPDATE=1.0
SNIFFER_PACKETS_PER_GC=50
SNIFFER_VERBOSE=0
ENABLE_HEURISTIC_ATTACK_OVERRIDE=0
ENABLE_SSH_FTP_HEURISTIC_OVERRIDE=1
ENABLE_WEB_HEURISTIC_OVERRIDE=0
SSH_BRUTE_WINDOW_SECONDS=180
SSH_BRUTE_MIN_ATTEMPTS=2
WHITELIST_ENABLED=1

# Tuning IDS/IPS
SENSOR_ZONE=lan
IPS_ATTACK_WINDOW_SECONDS=120
IPS_MIN_BLOCK_CONFIDENCE=0.85
ATTACK_MIN_CONFIDENCE=0.82
INFILTRATION_MIN_CONFIDENCE=0.90
LOCAL_NOISE_MIN_CONFIDENCE=0.93

# Gate para labels historicamente ruidosas (evita ataque por evento isolado)
NOISY_LABEL_WINDOW_SECONDS=45
NOISY_LABEL_MIN_EVENTS=3
NOISY_LABEL_MIN_CONFIDENCE=0.95
# NOISY_ATTACK_LABELS=infilteration,infiltration,bot,brute force -web,brute force -xss,sql injection

# Overrides opcionais por zona
# IPS_WAN_THRESHOLD=4
# IPS_WAN_MIN_BLOCK_CONFIDENCE=0.82
# IPS_WAN_ATTACK_WINDOW_SECONDS=90
# IPS_LAN_THRESHOLD=5
# IPS_LAN_MIN_BLOCK_CONFIDENCE=0.85
# IPS_LAN_ATTACK_WINDOW_SECONDS=120
# IPS_WLAN_THRESHOLD=5
# IPS_WLAN_MIN_BLOCK_CONFIDENCE=0.85
# IPS_WLAN_ATTACK_WINDOW_SECONDS=120
