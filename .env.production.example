# =========================
# AEGIS - Production env
# =========================

# Geral
APP_ENV=production
SECRET_KEY=troque_por_uma_chave_longa_e_aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# API / Frontend
FRONTEND_ORIGINS=https://frontend.seu-dominio.com,https://www.frontend.seu-dominio.com
# Opcional
# CORS_ALLOW_ORIGIN_REGEX=^https://([a-z0-9-]+\.)?seu-dominio\.com$

# Base de dados (cloud)
DATABASE_URL=postgresql://aegis:troque_esta_senha@db:5432/aegis
POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=troque_esta_senha
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=60

# Email / recuperação de password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@dominio.com
SMTP_PASS=sua_app_password_ou_senha

# Frontend build / runtime
VITE_API_BASE_URL=https://api.seu-dominio.com

# Sniffer em Docker no host da rede
SNIFFER_FLOW_ENDPOINT=https://api.seu-dominio.com/sniffer/flow-input
SNIFFER_INTERFACES=eth0,eth1
SNIFFER_EXPIRED_UPDATE=1.0
SNIFFER_PACKETS_PER_GC=50
SNIFFER_VERBOSE=0
ENABLE_HEURISTIC_ATTACK_OVERRIDE=1

# IDS/IPS
SENSOR_ZONE=lan
IPS_ATTACK_WINDOW_SECONDS=120
IPS_MIN_BLOCK_CONFIDENCE=0.85
ATTACK_MIN_CONFIDENCE=0.82
INFILTRATION_MIN_CONFIDENCE=0.90
LOCAL_NOISE_MIN_CONFIDENCE=0.93

# Overrides por zona (opcional)
# IPS_WAN_THRESHOLD=4
# IPS_WAN_MIN_BLOCK_CONFIDENCE=0.82
# IPS_WAN_ATTACK_WINDOW_SECONDS=90
# IPS_LAN_THRESHOLD=5
# IPS_LAN_MIN_BLOCK_CONFIDENCE=0.85
# IPS_LAN_ATTACK_WINDOW_SECONDS=120
# IPS_WLAN_THRESHOLD=5
# IPS_WLAN_MIN_BLOCK_CONFIDENCE=0.85
# IPS_WLAN_ATTACK_WINDOW_SECONDS=120
