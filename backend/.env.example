# Environment
APP_ENV=production

# Auth/JWT
SECRET_KEY=troque_por_uma_chave_grande_e_aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# CORS (separe por virgula)
FRONTEND_ORIGINS=https://seu-frontend.com,https://www.seu-frontend.com
# Opcional: regex complementar para CORS
# CORS_ALLOW_ORIGIN_REGEX=^https://([a-z0-9-]+\.)?seu-frontend\.com$

# Database
# Exemplo Postgres
DATABASE_URL=postgresql://usuario:senha@host:5432/aegis
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=60

# Recuperacao de senha por email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@dominio.com
SMTP_PASS=sua_senha_ou_app_password

# Opcionais de deteccao/IPS
# Zona do sensor: wan | lan | wlan
SENSOR_ZONE=lan

IPS_ATTACK_WINDOW_SECONDS=120
IPS_MIN_BLOCK_CONFIDENCE=0.85
ATTACK_MIN_CONFIDENCE=0.82
INFILTRATION_MIN_CONFIDENCE=0.90
LOCAL_NOISE_MIN_CONFIDENCE=0.93

# Overrides por zona (opcional)
# IPS_WAN_THRESHOLD=4
# IPS_WAN_MIN_BLOCK_CONFIDENCE=0.82
# IPS_WAN_ATTACK_WINDOW_SECONDS=90
# IPS_LAN_THRESHOLD=5
# IPS_LAN_MIN_BLOCK_CONFIDENCE=0.85
# IPS_LAN_ATTACK_WINDOW_SECONDS=120
# IPS_WLAN_THRESHOLD=5
# IPS_WLAN_MIN_BLOCK_CONFIDENCE=0.85
# IPS_WLAN_ATTACK_WINDOW_SECONDS=120
